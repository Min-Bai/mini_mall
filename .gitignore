# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code / AI 的配置与指令文件：只放本地，不入库
#   .claude/  = 本机配置（权限允许列表 / 钩子 / 上下文窗口）+ 技能包
#   CLAUDE.md = 项目规范
#   AGENTS.md = 由 next dev 自动生成，性质同下面的 next-env.d.ts
.claude/
CLAUDE.md
AGENTS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database (SQLite)
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/dev.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
